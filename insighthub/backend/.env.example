NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/insighthub

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

NEWSAPI_KEY=
GNEWS_API_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=

DEDUP_SIMILARITY_THRESHOLD=0.75
DEDUP_LOOKBACK_DAYS=7
TRENDING_WINDOW_HOURS=24
TRENDING_PUSH_INTERVAL_MINUTES=5
BREAKING_SPIKE_THRESHOLD=8
BREAKING_KEYWORDS=breaking,urgent,alert

RSS_FEED_URLS=
NYT_POLL_INTERVAL=*/30 * * * *
RSS_POLL_INTERVAL=*/25 * * * *

FETCH_CRON_DEFAULT=*/15 * * * *
NEWSAPI_POLL_INTERVAL=*/15 * * * *
GNEWS_POLL_INTERVAL=*/20 * * * *
GUARDIAN_POLL_INTERVAL=*/10 * * * *

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
