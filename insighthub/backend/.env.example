REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

NEWSAPI_KEY=
GNEWS_API_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=
CURRENTS_API_KEY=
# Alias also supported: CURRENTSAPI_KEY=

# News region — ISO 3166-1 alpha-2 (in = India)
NEWS_COUNTRY=in
NEWS_LANG=en
GUARDIAN_SECTION=world/india
NYT_SECTION=world

DEDUP_SIMILARITY_THRESHOLD=0.75
DEDUP_LOOKBACK_DAYS=7
TRENDING_WINDOW_HOURS=24
TRENDING_PUSH_INTERVAL_MINUTES=5
BREAKING_SPIKE_THRESHOLD=8
BREAKING_KEYWORDS=breaking,urgent,alert

RSS_FEED_URLS=
# Optional override — comma-separated Indian RSS URLs (replaces Hindu/Express/BBC India defaults)
NYT_POLL_INTERVAL=*/30 * * * *
RSS_POLL_INTERVAL=*/25 * * * *

FETCH_CRON_DEFAULT=*/15 * * * *
NEWSAPI_POLL_INTERVAL=*/15 * * * *
GNEWS_POLL_INTERVAL=*/20 * * * *
GUARDIAN_POLL_INTERVAL=*/10 * * * *
CURRENTS_POLL_INTERVAL=*/20 * * * *

JWT_SECRET=change-me-in-production
